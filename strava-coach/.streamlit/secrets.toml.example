# Copy this file to .streamlit/secrets.toml and fill it in.
#
# secrets.toml is git-ignored and must NEVER be committed — it contains a
# private key. On Streamlit Community Cloud you do not upload the file at all:
# paste the same content into Manage app → Settings → Secrets.
#
# Without this file the app still runs; it just keeps profiles in local files
# instead, which do not survive a restart on a hosted deploy.

# ---------------------------------------------------------------------------
# The service account, copied from the JSON key Google gives you.
# Paste the values across as-is. The private key is the fiddly one: keep it on
# a single line with \n escapes exactly as it appears in the JSON.
# ---------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "abc123..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
client_email = "strava-coach@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/strava-coach%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ---------------------------------------------------------------------------
# Which spreadsheet to use. The key is the long string in the sheet's URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
#
# Remember to share the sheet with the client_email above, as Editor —
# a service account is a separate identity and cannot see your files otherwise.
# ---------------------------------------------------------------------------
[sheets]
spreadsheet_key = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
# spreadsheet_url = "https://docs.google.com/spreadsheets/d/.../edit"
# spreadsheet_name = "strava-coach-data"
